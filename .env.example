LLM_MODE=mock
LLM_PROVIDER=zhipu
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=
TEXT_MODEL=glm-5.3-flash
VISION_MODEL=glm-5.3-flash
LLM_REASONING_EFFORT=low
# 思考模式：qwen3.8-flash 开启后单次调用可慢至 30-90s。
# 提取/分类类任务关掉明显提速（设 false）；追求判定质量可设 true。
LLM_ENABLE_THINKING=true
# stream 留空=按供应商默认（zhipu 非流式 / openai_compatible 流式）
LLM_STREAM=
LLM_CONNECT_TIMEOUT_SECONDS=15
LLM_READ_TIMEOUT_SECONDS=180
LLM_REQUEST_DEADLINE_SECONDS=240
LLM_MAX_CONCURRENCY=1
LLM_MAX_ATTEMPTS=3
# 供应商限流节流：两次真实请求的最小间隔秒数。
# 智谱共享接口曾触发 429（设 8）；阿里云百炼专用端点通常可放宽到 3。
LLM_MIN_REQUEST_INTERVAL_SECONDS=3

# ---- 切换到阿里云百炼（OpenAI 兼容端点）时改用以下配置 ----
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=https://llm-hn4tgglwfnsxda54.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=你的百炼APIKey（也可放在系统环境变量 DASHSCOPE_API_KEY）
# TEXT_MODEL=qwen3.8-flash
# VISION_MODEL=qwen3.8-flash

# ---- embedding 增强（可选；对话端点不支持 embedding 时配这里走官方端点） ----
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_API_KEY=你的官方百炼Key
